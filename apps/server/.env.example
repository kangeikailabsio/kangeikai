# LiveKit connection/signing config (see docker-compose.dev.yml at the repo root for the
# local dev server these fixed values match — spec 003 "Proximity Voice & Video").
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Signs the proof OfficeRoom.onJoin sends the client, which /livekit-token then verifies to
# confirm a token request's identity really came from a live Colyseus session (session-proof.ts).
# Generate a real random value for production — never reuse this dev placeholder.
SESSION_SIGNING_SECRET=dev-session-signing-secret

# Optional shared-secret room lock (OfficeRoom.onAuth) — when set, only guests who type this
# exact code on the entry form can join at all (movement, presence, and proximity audio/video
# all depend on a successful join). Leave unset for open local dev; set a real value in
# production to restrict access to whoever you share it with.
# ACCESS_CODE=

# Accounts — better-auth on this server + PostgreSQL (issue #231). All of these are required:
# the server refuses to start without them.
#
# Postgres from docker-compose.dev.yml. Create the tables once with `pnpm --filter @kangeikai/server db:migrate`.
DATABASE_URL=postgres://kangeikai:kangeikai@localhost:5432/kangeikai
# Signs sessions and cookies. At least 32 characters; generate a real random value for production
# (e.g. `openssl rand -base64 32`) — never reuse this dev placeholder.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-in-production
# Where this server is reachable from the browser (origin only). Used for OAuth callbacks.
BETTER_AUTH_URL=http://localhost:2567
# Origin(s) of the web client allowed to call the auth routes with cookies, comma-separated.
CLIENT_ORIGIN=http://localhost:5173
# Production with the site and this server on sibling subdomains (e.g. app.example.com and
# api.app.example.com): share the session cookie by scoping it to the site's host.
# COOKIE_DOMAIN=app.example.com
# Google sign-in (always on). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with this redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google. These placeholders let the
# server boot locally; email and password works without real values, the Google button does not.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
