{
  "name": "kangeikai",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/client dev",
    "dev:client": "pnpm --filter ./apps/client dev",
    "dev:server": "pnpm --filter ./apps/server dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait && pnpm --filter @kangeikai/server db:migrate && pnpm --filter @kangeikai/server db:seed",
    "build": "pnpm --filter ./apps/client build",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "check": "pnpm -r --if-present check",
    "test:e2e": "pnpm --filter @kangeikai/e2e test:e2e",
    "capture:landing": "pnpm --filter @kangeikai/e2e capture:landing"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^2.46.0",
    "lint-staged": "^15.2.0",
    "svelte-eslint-parser": "^0.43.0"
  }
}
