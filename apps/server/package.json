{
  "name": "@kangeikai/server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed-cli.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "db:generate-auth-schema": "npx auth@latest generate --config src/auth/auth-cli.ts --output src/db/schema.ts -y && eslint --fix src/db/schema.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.31",
    "@colyseus/ws-transport": "^0.17.13",
    "@kangeikai/game-pool": "workspace:*",
    "@kangeikai/shared": "workspace:*",
    "better-auth": "^1.7.18",
    "colyseus": "^0.17.10",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "livekit-server-sdk": "^2.18.0",
    "pg": "^8.23.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/testing": "^0.17.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
